NODE_ENV=development
HOST=0.0.0.0
PORT=8788
DATABASE_URL=postgres://postgres:postgres@localhost:55432/data_trade
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
AUTH_COOKIE_NAME=data_trade_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
IP_HASH_SECRET=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
DATA_TRADE_ADMIN_EMAIL=admin@datatrade.local
DATA_TRADE_ADMIN_PASSWORD=
DATA_TRADE_ADMIN_NAME=Data Trade Admin
REQUEST_BODY_LIMIT_BYTES=65536
EVENT_METADATA_MAX_BYTES=8192
EVENT_RATE_LIMIT_MAX=120
EVENT_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
